<%- include('partials/header') %>

<div class="login-wrapper-centered">
    <div class="login-panel" style="width: 100%;">
        <div class="login-header">
            <h2>Willkommen zurück</h2>
            <p>Melden Sie sich an, um Ihre Raumbelegungen zu verwalten.</p>
        </div>

        <% if (jwtConfig.enabled && jwtConfig.sso_url) { %>
            <div class="sso-container">
                <a href="<%= jwtConfig.sso_url %>" class="btn-sso-login">
                    <span class="sso-icon">🔐</span>
                    <span>Mit MSO-Portal anmelden</span>
                </a>
                <div class="sso-separator">
                    <span>oder lokal anmelden</span>
                </div>
            </div>
        <% } %>

        <form action="/login" method="POST" class="modern-form">
            <div class="form-group">
                <label for="username">Benutzername</label>
                <div class="input-wrapper">
                    <span class="input-icon">👤</span>
                    <input type="text" name="username" id="username" required placeholder="z. B. s.fleischer" autocomplete="username">
                </div>
            </div>

            <div class="form-group">
                <label for="password">Passwort</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔑</span>
                    <input type="password" name="password" id="password" required placeholder="Ihr Passwort" autocomplete="current-password">
                </div>
            </div>

            <button type="submit" class="btn-primary-block">
                <span>Anmelden</span>
                <span class="btn-arrow">→</span>
            </button>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
