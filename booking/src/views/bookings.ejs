        </form>
        
        <form action="/bookings/cancel" method="POST" onsubmit="return confirm('Möchten Sie diese Buchung wirklich stornieren?');" style="margin-top: 12px;">
            <input type="hidden" name="booking_id" id="admin-cancel-booking-id">
            <input type="hidden" name="room_id" id="admin-cancel-booking-room-id">
            <input type="hidden" name="date" id="admin-cancel-booking-date">
            <button type="submit" class="btn-danger-sm" style="width: 100%; padding: 14px; justify-content: center; font-size: 14px; font-weight: 700; border-radius: 14px;">
