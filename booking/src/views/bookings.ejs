<% const loadBookingScript = true; %>
<%- include('partials/header') %>

<script>
    window.currentRoomBookings = <%- JSON.stringify(typeof bookingRows !== 'undefined' && bookingRows ? bookingRows : []) %>;
    window.currentWeekDatesMap = <%- JSON.stringify(typeof weekDatesMap !== 'undefined' && weekDatesMap ? weekDatesMap : {}) %>;
</script>

<% const isPublicView = typeof isPublicReadOnly !== 'undefined' && isPublicReadOnly; %>
<% const routePath = isPublicView ? '/public' : '/bookings'; %>

<% if (isPublicView) { %>
    <div style="margin-bottom: 20px; padding: 14px 20px; border-radius: 16px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); color: var(--text-main); font-size: 14px; display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 22px;">👁️</span>
        <div>
            <strong>Öffentlicher Belegungsplan (Nur-Lese-Ansicht):</strong> Sie betrachten den Plan für <strong><%= room.name %></strong>.
        </div>
    </div>
<% } %>

<div class="calendar-header-bar card">
    <!-- Room Selector & Breadcrumb -->
    <div class="calendar-info">
        <div class="calendar-breadcrumb">
            <% if (isPublicView) { %>
                <span>Öffentlicher Belegungsplan</span> &raquo; <strong><%= room.name %></strong>
            <% } else { %>
                <a href="<%= routePath %>">Dashboard</a> &raquo; <strong><%= room.name %></strong>
            <% } %>
        </div>
        <h2>
            <span class="room-icon-inline" style="display: inline-flex; align-items: center;">
                <% if (room.icon === 'computer') { %>
                    <svg style="width: 24px; height: 24px; fill: var(--primary); vertical-align: middle;" viewBox="0 0 24 24"><path d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.11-.9-2-2-2H4c-1.11 0-2 .89-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/></svg>
                <% } else if (room.icon === 'science') { %>
                    <svg style="width: 24px; height: 24px; fill: var(--primary); vertical-align: middle;" viewBox="0 0 24 24"><path d="M19 19.5c0 .8-.7 1.5-1.5 1.5h-11C5.7 21 5 20.3 5 19.5v-1.1c0-.4.2-.8.5-1L9 12.3V5c0-.6.4-1 1-1h4c.6 0 1 .4 1 1v7.3l3.5 5.1c.3.2.5.6.5 1v1.1z"/></svg>
                <% } else { %>
                    <svg style="width: 24px; height: 24px; fill: var(--primary); vertical-align: middle;" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.5 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
                <% } %>
            </span>
            <%= room.name %> <span class="room-location-tag"><%= room.department_name || 'Keine Kategorie' %></span>
        </h2>
    </div>

    <% if (!isPublicView) { %>
        <!-- Cascading Room Selectors (Category -> Room) -->
        <div class="calendar-controls">
            <div class="calendar-selectors" style="display: flex; align-items: center; gap: 8px;">
                <div class="calendar-select-wrapper" style="display: flex; align-items: center;">
                    <span class="calendar-select-label" style="font-size: 13.5px; font-weight: 700; color: var(--text-muted);">Kategorie:</span>
                    <select id="calendar-category-select" style="padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-size: 13.5px; font-weight: 600; cursor: pointer; outline: none; transition: border-color 0.2s;">
                        <option value="">-- Alle --</option>
                        <% if (typeof headerCategories !== 'undefined' && headerCategories && headerCategories.length) { %>
                            <% headerCategories.forEach(cat => { %>
                                <option value="<%= cat.department_id %>" <%= room.department_id == cat.department_id ? 'selected' : '' %>><%= cat.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>


                <form action="<%= routePath %>" method="GET" class="room-select-form" id="calendar-room-form" style="margin: 0;">
                    <label for="calendar-room-select" class="calendar-select-label" style="font-size: 13.5px; font-weight: 700; color: var(--text-muted); margin: 0;">Medium / Raum:</label>
                    <select name="room_id" id="calendar-room-select" onchange="this.form.submit()" style="padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-size: 13.5px; font-weight: 600; cursor: pointer; outline: none; transition: border-color 0.2s;">
                        <% allRooms.forEach(r => { %>
                            <option value="<%= r.room_id %>" data-dept="<%= r.department_id || '' %>" <%= r.room_id == room.room_id ? 'selected' : '' %>>
                                <%= r.name %>
                            </option>
                        <% }) %>
                    </select>
                    <input type="hidden" name="date" value="<%= selectedDate %>">
                </form>
            </div>
        </div>
    <% } %>
</div>

<% if (typeof isOutsideAcademicYear !== 'undefined' && isOutsideAcademicYear) { %>
    <div style="margin-bottom: 16px; padding: 12px 18px; border-radius: 14px; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); color: var(--text-main); font-size: 13.5px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 18px;">⚠️</span>
            <div>
                <strong>Hinweis zum Schuljahr:</strong> Diese Kalenderwoche liegt außerhalb des aktuell eingestellten Schuljahres 
                <% if (typeof academicYear !== 'undefined' && academicYear && academicYear.date_start && academicYear.date_end) { %>
                    (<%= academicYear.date_start.split('-').reverse().join('.') %> – <%= academicYear.date_end.split('-').reverse().join('.') %>).
                <% } else { %>
                    .
                <% } %>
                Dauerbuchungen mit A/B-Turnus werden hier nicht angezeigt.
            </div>
        </div>
        <% if (authlevel === 1) { %>
            <a href="/admin/weeks" class="btn-secondary" style="font-size: 12.5px; padding: 6px 12px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                ⚙️ Schuljahr / Wochentypen anpassen
            </a>
        <% } %>
    </div>
<% } else if (typeof weeks !== 'undefined' && weeks && weeks.length > 0 && typeof weekName !== 'undefined' && !weekName) { %>
    <div style="margin-bottom: 16px; padding: 12px 18px; border-radius: 14px; background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.3); color: var(--text-main); font-size: 13.5px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 18px;">ℹ️</span>
            <div>
                <strong>Hinweis zum Wochentyp:</strong> Dieser Kalenderwoche wurde noch kein Turnus (z. B. A-Woche oder B-Woche) zugewiesen.
            </div>
        </div>
        <% if (authlevel === 1) { %>
            <a href="/admin/weeks" class="btn-secondary" style="font-size: 12.5px; padding: 6px 12px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                ⚙️ Wochentyp zuweisen
            </a>
        <% } %>
    </div>
<% } %>

<!-- Week Navigation Bar -->
<div class="week-navigation" style="display: flex; justify-content: space-between; align-items: center; gap: 10px;">
    <div style="display: flex; align-items: center; gap: 8px;">
        <a href="<%= routePath %>?room_id=<%= room.room_id %>&date=<%= prevWeek %>" class="btn-nav-week">
            <span class="nav-text-desktop">&larr; Vorherige Woche</span>
            <span class="nav-text-mobile">&larr; Zurück</span>
        </a>
    </div>

    <div class="week-title-badge" id="week-datepicker-trigger" title="Wunschwoche auswählen...">
        <span class="nav-badge-desktop">📅 Woche vom <strong><%= mondayStr %></strong> <%= typeof weekName !== 'undefined' && weekName ? `(${weekName})` : '' %></span>
        <span class="nav-badge-mobile">📅 <strong><%= mondayStr %></strong></span>
        <!-- Hidden input covering the badge to trigger native datepicker -->
        <input type="date" id="week-datepicker-input" value="<%= selectedDate %>" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; border: none; padding: 0; z-index: 10; -webkit-appearance: none;">
    </div>

    <div style="display: flex; align-items: center; gap: 8px;">
        <a href="<%= routePath %>?room_id=<%= room.room_id %>&date=<%= nextWeek %>" class="btn-nav-week">
            <span class="nav-text-desktop">Nächste Woche &rarr;</span>
            <span class="nav-text-mobile">Weiter &rarr;</span>
        </a>
        <% if (typeof authlevel !== 'undefined' && authlevel === 1) { %>
            <a href="/bookings/daily?date=<%= selectedDate %>" class="btn-secondary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; border-radius: 10px; text-decoration: none; padding: 8px 14px; font-size: 13px;">
                <span>📋 Tagesübersicht</span>
            </a>
        <% } %>
        <button type="button" class="btn-secondary" onclick="openShareModal('<%= room.room_id %>', '<%= selectedDate %>')" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; border-radius: 10px; cursor: pointer; padding: 8px 14px; font-size: 13px;">
            <span>🔗 Teilen</span>
        </button>
    </div>
</div>

<!-- The Weekly Schedule Grid -->
<div class="calendar-grid-container card">
    <table class="modern-calendar">
        <thead>
            <tr>
                <th class="time-col">
                    <span class="period-header-desktop">Zeitstunde</span>
                    <span class="period-header-mobile">Std.</span>
                </th>
                <% for (let i = 0; i < 5; i++) { %>
                    <th>
                        <div class="header-day-name">
                            <span class="day-name-desktop"><%= weekDaysNames[i] %></span>
                            <span class="day-name-mobile"><%= weekDaysNames[i][0] %></span>
                        </div>
                        <div class="header-day-date">
                            <%= new Date(weekDates[i]).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' }) %>
                        </div>
                    </th>
                <% } %>
            </tr>
        </thead>
        <tbody>
            <% periods.forEach(period => { %>
                <tr <% if (period.color) { %>style="--period-accent-color: <%= period.color %>;"<% } %>>
                    <!-- Period Info Column -->
                    <td class="time-col" <% if (period.color) { %>style="border-left: 6px solid <%= period.color %>; background: <%= period.color %>22; border-right: 2px solid <%= period.color %>40;"<% } %>>
                        <div class="period-name" <% if (period.color) { %>style="color: <%= period.color %>; font-weight: 800;"<% } %>>
                            <span class="period-name-desktop">
                                <% if (period.color) { %>
                                    <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: <%= period.color %>; margin-right: 6px; box-shadow: 0 0 8px <%= period.color %>; vertical-align: middle;"></span>
                                <% } %>
                                <%= period.name %>
                            </span>
                            <span class="period-name-mobile" <% if (period.color) { %>style="color: <%= period.color %>; font-weight: 800;"<% } %>><%= period.name.slice(0, 3) %></span>
                        </div>
                        <div class="period-time">
                            <span class="period-time-desktop" <% if (period.color) { %>style="color: <%= period.color %>; opacity: 1; font-weight: 700;"<% } %>><%= period.time_start.slice(0, 5) %> - <%= period.time_end.slice(0, 5) %></span>
                            <span class="period-time-mobile" <% if (period.color) { %>style="color: <%= period.color %>; font-weight: 700;"<% } %>><%= period.time_start.slice(0, 5) %></span>
                        </div>
                    </td>

                    <!-- Days Slots Columns -->
                    <% for (let dayIdx = 0; dayIdx < 5; dayIdx++) { %>
                        <% 
                            const currentDate = weekDates[dayIdx];
                            const lookupKey = `${currentDate}_${period.period_id}`;
                            const timetableKey = `day_${dayIdx + 1}_${period.period_id}`;
                            
                            const booking = gridBookings[lookupKey];
                            const timetable = gridBookings[timetableKey];
                        %>
                        
                        <% if (typeof holidayMap !== 'undefined' && holidayMap && holidayMap[currentDate]) { %>
                            <!-- Holiday Slot Block -->
                            <td class="slot slot-holiday clickable" 
                                onclick="openDetailModal('<%= room.name.replace(/'/g, "\\'") %>', '<%= period.name.replace(/'/g, "\\'") %>', '<%= currentDate %>', 'Feiertag / Ferien', '<%= holidayMap[currentDate].replace(/'/g, "\\'") %>')">
                                <div class="slot-content">
                                    <span class="slot-desc-desktop">
                                        <span style="font-size: 16px; margin-bottom: 2px;">🏝️</span>
                                        <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--success);"><%= holidayMap[currentDate] %></div>
                                        <div style="font-size: 10px; color: var(--text-muted); margin-top: 1px;">Schulfrei</div>
                                    </span>
                                    <span class="slot-desc-mobile">🏝️</span>
                                </div>
                            </td>
                        <% } else if (booking) { %>
                            <!-- Dynamic Single Booking Cell -->
                            <% const isMine = booking.user_id === currentUserId; %>
                            <td class="slot booked <%= isMine ? 'slot-mine' : 'slot-staff' %> clickable"
                                <% if (isMine || authlevel === 1) { %>
                                    data-booking-id="<%= booking.booking_id %>"
                                    data-notes="<%= booking.notes || '' %>"
                                    data-room-name="<%= room.name %>"
                                    data-period-name="<%= period.name %>"
                                    data-date="<%= currentDate %>"
                                    data-is-timetable="false"
                                    data-user-name="<%= booking.displayname || booking.username %>"
                                    onclick="handleEditBtnClick(event, this)"
                                <% } else { %>
                                    onclick="openDetailModal('<%= room.name.replace(/'/g, "\\'") %>', '<%= period.name.replace(/'/g, "\\'") %>', '<%= currentDate %>', '<%= (booking.firstname + ' ' + booking.lastname + ' (' + booking.username + ')').replace(/'/g, "\\'") %>', '<%= (booking.notes || 'Keine Angabe').replace(/'/g, "\\'") %>')"
                                <% } %>
                            >
                                <div class="slot-content">
                                    <span class="slot-desc-desktop">
                                        <span class="slot-badge">
                                            <% if (isMine) { %>
                                                <svg class="badge-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>Meine Buchung
                                            <% } else { %>
                                                <svg class="badge-icon" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>Lehrkraft
                                            <% } %>
                                        </span>
                                        <div class="slot-user"><%= booking.displayname || booking.username %></div>
                                        <% if (booking.notes) { %>
                                            <div class="slot-notes">"<%= booking.notes %>"</div>
                                        <% } %>
                                    </span>
                                    
                                    <span class="slot-desc-mobile slot-booked-mobile">x</span>
                                    
                                    <!-- Tooltip card on Hover -->
                                    <div class="slot-tooltip">
                                        <h4>📅 Buchungsdetails</h4>
                                        <p><strong>Raum:</strong> <%= room.name %></p>
                                        <p><strong>Stunde:</strong> <%= period.name %> (<%= period.time_start.slice(0, 5) %> - <%= period.time_end.slice(0, 5) %>)</p>
                                        <p><strong>Gebucht von:</strong> <%= booking.firstname %> <%= booking.lastname %> (<%= booking.username %>)</p>
                                        <% if (booking.notes) { %>
                                            <p><strong>Notiz:</strong> "<%= booking.notes %>"</p>
                                        <% } %>
                                    </div>

                                    <% if (isMine || authlevel === 1) { %>
                                        <div class="slot-actions-bar" style="display: flex; gap: 4px; align-items: center; justify-content: flex-end; margin-top: 4px;" onclick="event.stopPropagation()">
                                            <button type="button" class="btn-slot-cancel btn-edit-booking-trigger" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border-color: rgba(59, 130, 246, 0.3);" title="Buchung bearbeiten"
                                                data-booking-id="<%= booking.booking_id %>"
                                                data-notes="<%= booking.notes || '' %>"
                                                data-room-name="<%= room.name %>"
                                                data-period-name="<%= period.name %>"
                                                data-date="<%= currentDate %>"
                                                data-is-timetable="false"
                                                data-user-name="<%= booking.displayname || booking.username %>"
                                                onclick="handleEditBtnClick(event, this)">
                                                ✏️
                                            </button>
                                            <form action="/bookings/cancel" method="POST" class="cancel-form" onsubmit="return window.confirmCancelBooking(this, <%= booking.group_id ? 'true' : 'false' %>);" onclick="event.stopPropagation()">
                                                <input type="hidden" name="booking_id" value="<%= booking.booking_id %>">
                                                <input type="hidden" name="room_id" value="<%= room.room_id %>">
                                                <input type="hidden" name="date" value="<%= selectedDate %>">
                                                <input type="hidden" name="cancel_all_group" value="0">
                                                <button type="submit" class="btn-slot-cancel" title="Stornieren" onclick="event.stopPropagation()">
                                                    <svg class="trash-icon" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                                                </button>
                                            </form>
                                        </div>
                                    <% } %>
                                </div>
                            </td>
                        <% } else if (timetable) { %>
                            <!-- Static Timetabled Block Cell -->
                            <td class="slot booked slot-static clickable"
                                <% if (authlevel === 1) { %>
                                    data-booking-id="<%= timetable.booking_id %>"
                                    data-notes="<%= timetable.notes || 'Unterricht' %>"
                                    data-room-name="<%= room.name %>"
                                    data-period-name="<%= period.name %>"
                                    data-date="<%= currentDate %>"
                                    data-is-timetable="true"
                                    data-week-id="<%= timetable.week_id || '' %>"
                                    data-date-start="<%= timetable.date_start || currentDate %>"
                                    data-date-end="<%= timetable.date_end || '' %>"
                                    data-user-name="<%= timetable.displayname || timetable.username || 'Stundenplan' %>"
                                    onclick="handleEditBtnClick(event, this)"
                                <% } else { %>
                                    onclick="openDetailModal('<%= room.name.replace(/'/g, "\\'") %>', '<%= period.name.replace(/'/g, "\\'") %>', '<%= currentDate %>', 'Stundenplan', '<%= (timetable.notes || "Regulärer Unterricht").replace(/'/g, "\\'") %>')"
                                <% } %>
                            >
                                <div class="slot-content">
                                    <span class="slot-desc-desktop">
                                        <span class="slot-badge">
                                            <svg class="badge-icon" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>Stundenplan
                                        </span>
                                        <div class="slot-user"><%= timetable.notes || 'Unterricht' %></div>
                                    </span>
                                    
                                    <span class="slot-desc-mobile slot-static-mobile">x</span>
                                    
                                    <!-- Tooltip card on Hover -->
                                    <div class="slot-tooltip">
                                        <h4>⏰ Stundenplaneintrag</h4>
                                        <p>Dieser Slot ist fest durch den regulären Stundenplan belegt.</p>
                                        <p><strong>Stunde:</strong> <%= period.name %></p>
                                        <p><strong>Zweck:</strong> <%= timetable.notes || 'Regulärer Unterricht' %></p>
                                    </div>

                                    <% if (authlevel === 1) { %>
                                        <div class="slot-actions-bar" style="display: flex; gap: 4px; align-items: center; justify-content: flex-end; margin-top: 4px;" onclick="event.stopPropagation()">
                                            <button type="button" class="btn-slot-cancel btn-edit-booking-trigger" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border-color: rgba(59, 130, 246, 0.3);" title="Dauerbuchung bearbeiten"
                                                data-booking-id="<%= timetable.booking_id %>"
                                                data-notes="<%= timetable.notes || 'Unterricht' %>"
                                                data-room-name="<%= room.name %>"
                                                data-period-name="<%= period.name %>"
                                                data-date="<%= currentDate %>"
                                                data-is-timetable="true"
                                                data-week-id="<%= timetable.week_id || '' %>"
                                                data-date-start="<%= timetable.date_start || currentDate %>"
                                                data-date-end="<%= timetable.date_end || '' %>"
                                                data-user-name="<%= timetable.displayname || timetable.username || 'Stundenplan' %>"
                                                onclick="handleEditBtnClick(event, this)">
                                                ✏️
                                            </button>
                                            <form action="/admin/timetables/delete" method="POST" class="cancel-form" onsubmit="return confirm('Möchten Sie diesen Stundenplaneintrag wirklich löschen?');" onclick="event.stopPropagation()">
                                                <input type="hidden" name="booking_id" value="<%= timetable.booking_id %>">
                                                <input type="hidden" name="redirect_to" value="/bookings?room_id=<%= room.room_id %>&date=<%= selectedDate %>">
                                                <button type="submit" class="btn-slot-cancel" title="Stundenplaneintrag löschen" onclick="event.stopPropagation()">
                                                    <svg class="trash-icon" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                                                </button>
                                            </form>
                                        </div>
                                    <% } %>
                                </div>
                            </td>
                        <% } else { %>
                            <!-- Free Bookable Slot Cell -->
                            <% if (isPublicView) { %>
                                <td class="slot slot-free" <% if (period.color) { %>style="background: <%= period.color %>18; border-top: 1.5px solid <%= period.color %>40; border-bottom: 1.5px solid <%= period.color %>40;"<% } %>>
                                    <div class="slot-content">
                                        <span style="color: <%= period.color ? period.color : 'var(--text-muted)' %>; font-size: 12px; font-weight: 700; opacity: 0.9;">Frei</span>
                                    </div>
                                </td>
                            <% } else { %>
                                <td class="slot slot-free clickable" <% if (period.color) { %>style="background: <%= period.color %>18; border-top: 1.5px solid <%= period.color %>40; border-bottom: 1.5px solid <%= period.color %>40;"<% } %>
                                    onclick="openBookingModal('<%= room.room_id %>', '<%= room.name %>', '<%= period.period_id %>', '<%= period.name %>', '<%= currentDate %>')">
                                    <div class="slot-content">
                                        <span class="btn-slot-add" <% if (period.color) { %>style="color: <%= period.color %>; border-color: <%= period.color %>60; background: <%= period.color %>15;"<% } %>>
                                            <span class="slot-free-desktop">+ Reservieren</span>
                                            <span class="slot-free-mobile">+</span>
                                        </span>
                                    </div>
                                </td>
                            <% } %>
                        <% } %>
                    <% } %>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<!-- High-End Glassmorphic Booking Overlay Modal -->
<div id="booking-modal" class="modal-overlay hidden" onclick="closeBookingModal(event)">
    <div class="modal-card card" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h3>🏫 Medium / Raum reservieren</h3>
            <button class="btn-close-modal" onclick="closeBookingModal(force=true)">&times;</button>
        </div>
        <p class="modal-desc">Füllen Sie die Details aus, um Ihre Belegung abzuschließen.</p>
        
        <form action="/bookings/add" method="POST" class="modern-form">
            <input type="hidden" name="room_id" id="modal-room-id">
            <input type="hidden" name="period_id" id="modal-period-id">
            <input type="hidden" name="date" id="modal-date">

            <input type="hidden" name="is_range" id="modal-is-range" value="0">

            <!-- Always visible: Room / Medium -->
            <div class="form-group" style="margin-bottom: 16px;">
                <label>Medium / Raum</label>
                <input type="text" id="modal-room-name" readonly class="input-readonly">
            </div>

            <% if (authlevel === 1) { %>
                <!-- Mode Switcher: Einzelstunde vs Mehrstündig / Zeitraum -->
                <div class="mode-toggle-bar" style="display: flex; background: var(--bg-secondary, rgba(0,0,0,0.06)); padding: 4px; border-radius: 12px; margin-bottom: 18px; border: 1px solid var(--border-color); gap: 4px;">
                    <button type="button" id="btn-mode-single" class="mode-toggle-btn active" onclick="setBookingModalMode('single')" style="flex: 1; padding: 9px 12px; border: none; border-radius: 9px; font-weight: 700; font-size: 13px; cursor: pointer; transition: all 0.2s ease; background: var(--bg-card, #ffffff); color: var(--primary, #2563eb); box-shadow: 0 2px 6px rgba(0,0,0,0.08);">
                        ⏱️ Einzelstunde
                    </button>
                    <button type="button" id="btn-mode-range" class="mode-toggle-btn" onclick="setBookingModalMode('range')" style="flex: 1; padding: 9px 12px; border: none; border-radius: 9px; font-weight: 700; font-size: 13px; cursor: pointer; transition: all 0.2s ease; background: transparent; color: var(--text-muted);">
                        📅 Mehrstündig / Zeitraum
                    </button>
                </div>
            <% } %>

            <!-- SECTION A: Einzelstunde (Hidden when in Zeitraum mode) -->
            <div id="modal-section-single">
                <div class="form-row">
                    <div class="form-group">
                        <label>Datum</label>
                        <input type="text" id="modal-date-formatted" readonly class="input-readonly">
                    </div>
                    <div class="form-group">
                        <label>Unterrichtsstunde</label>
                        <input type="text" id="modal-period-name" readonly class="input-readonly">
                    </div>
                </div>

                <% if (authlevel === 1) { %>
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label for="modal-booking-type">Belegungstyp</label>
                        <select name="booking_type" id="modal-booking-type" onchange="toggleBookingTypeFields(this.value)" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600; cursor: pointer; outline: none; transition: border-color 0.2s;">
                            <option value="single">Einzelreservierung (für dieses Datum)</option>
                            <option value="timetable">Dauerhafte Stundenplanblockierung</option>
                        </select>
                    </div>

                    <div class="form-group hidden" id="modal-week-rotation-group" style="margin-bottom: 15px;">
                        <label for="modal-week-id">Wiederholung (Turnus)</label>
                        <select name="week_id" id="modal-week-id" onchange="checkModalCollisions()" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600; cursor: pointer; outline: none; transition: border-color 0.2s;">
                            <option value="">Wöchentlich (Jede Woche)</option>
                            <% if (typeof weeks !== 'undefined' && weeks && weeks.length) { %>
                                <% weeks.forEach(wk => { %>
                                    <option value="<%= wk.week_id %>"><%= wk.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <!-- Date Range Group for Timetable Bookings (Von - Bis) -->
                    <div class="form-row hidden" id="modal-date-range-group" style="margin-bottom: 15px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="modal-date-start">Gültig von (Startdatum)</label>
                            <input type="date" name="date_start" id="modal-date-start" onchange="checkModalCollisions()" style="padding: 10px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600; width: 100%;">
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="modal-date-end">Gültig bis (Enddatum)</label>
                            <input type="date" name="date_end" id="modal-date-end" onchange="onBisDateChange(this.value)" style="padding: 10px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600; width: 100%;">
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- SECTION B: Mehrstündig / Zeitraum (Admin only, shown only when toggle is on 'range') -->
            <% if (authlevel === 1) { %>
                <div id="modal-section-range" class="hidden" style="margin-bottom: 15px;">
                    <div class="form-row" style="margin-bottom: 12px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="modal-period-id-start">Von Stunde</label>
                            <select name="period_id_start" id="modal-period-id-start" onchange="syncAdminRangePeriod(this.value)" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600;">
                                <% periods.forEach(p => { %>
                                    <option value="<%= p.period_id %>"><%= p.name %> (<%= p.time_start.slice(0,5) %> - <%= p.time_end.slice(0,5) %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="modal-period-id-end">Bis Stunde</label>
                            <select name="period_id_end" id="modal-period-id-end" onchange="checkModalCollisions()" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600;">
                                <% periods.forEach(p => { %>
                                    <option value="<%= p.period_id %>"><%= p.name %> (<%= p.time_start.slice(0,5) %> - <%= p.time_end.slice(0,5) %>)</option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="form-row" style="margin-bottom: 8px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="modal-date-range-start">Startdatum</label>
                            <input type="date" name="date_start_booking" id="modal-date-range-start" onchange="onRangeStartDateChange(this.value)" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600;">
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="modal-date-range-end">Enddatum</label>
                            <input type="date" name="date_end_booking" id="modal-date-range-end" onchange="checkModalCollisions()" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600;">
                        </div>
                    </div>
                    <div style="font-size: 12px; color: var(--text-muted); margin-top: 8px; padding: 8px 12px; background: rgba(59, 130, 246, 0.08); border-radius: 8px; border: 1px solid rgba(59, 130, 246, 0.15);">
                        💡 <em>Wochenenden (Sa/So) und hinterlegte Feiertage werden im gewählten Zeitraum automatisch übersprungen.</em>
                    </div>
                </div>
            <% } %>

            <div class="form-group">
                <label for="modal-notes">Verwendungszweck / Klasse (optional)</label>
                <input type="text" name="notes" id="modal-notes" placeholder="z. B. 10b Informatik, Mathearbeit" autofocus>
            </div>
            
            <% if (authlevel === 1) { %>
                <!-- Live Collision Information Box -->
                <div id="modal-collision-info" class="hidden" style="margin-top: 12px; margin-bottom: 12px; padding: 12px 14px; border-radius: 12px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: var(--text-main); font-size: 12.5px;">
                    <div style="font-weight: 700; color: #ef4444; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                        <span>⚠️ Kollisionshinweis</span>
                    </div>
                    <div id="modal-collision-details" style="line-height: 1.5;"></div>
                </div>

                <!-- Overwrite Checkbox Container (Hidden until collision) -->
                <div class="form-group inline-checkbox hidden" id="modal-overwrite-container" style="margin-top: 10px; margin-bottom: 15px;">
                    <label for="modal-overwrite" style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--warning, #f59e0b);">
                        <input type="checkbox" name="overwrite" id="modal-overwrite" value="1" onchange="checkModalCollisions()" style="width: 18px; height: 18px; accent-color: var(--warning, #f59e0b); cursor: pointer;">
                        <span>⚡ Bestehende Kollisionen überschreiben</span>
                    </label>
                </div>
            <% } %>

            <button type="submit" id="modal-submit-btn" class="btn-primary-block">
                <span>📝 Buchung verbindlich speichern</span>
            </button>
        </form>
    </div>
</div>

<!-- High-End Glassmorphic Read-Only Detail Overlay Modal -->
<div id="detail-modal" class="modal-overlay hidden" onclick="closeDetailModal()">
    <div class="modal-card card" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h3>📅 Reservierungsdetails</h3>
            <button class="btn-close-modal" onclick="closeDetailModal()">&times;</button>
        </div>
        <p class="modal-desc">Details zur ausgewählten Belegung.</p>
        
        <div class="modern-form compact">
            <div class="form-row" style="margin-bottom: 12px;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Medium / Raum</label>
                    <input type="text" id="detail-room-name" readonly class="input-readonly" style="padding: 10px;">
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Datum</label>
                    <input type="text" id="detail-date-formatted" readonly class="input-readonly" style="padding: 10px;">
                </div>
            </div>

            <div class="form-row" style="margin-bottom: 12px;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Unterrichtsstunde</label>
                    <input type="text" id="detail-period-name" readonly class="input-readonly" style="padding: 10px;">
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Gebucht von</label>
                    <input type="text" id="detail-user" readonly class="input-readonly" style="padding: 10px;">
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label>Verwendungszweck / Klasse</label>
                <input type="text" id="detail-notes" readonly class="input-readonly" style="padding: 12px;">
            </div>

            <button class="btn-primary-block" onclick="closeDetailModal()" style="width: 100%;">
                <span>Schließen</span>
            </button>
        </div>
    </div>
</div>

<%- include('partials/share_modal') %>
<%- include('partials/edit_booking_modal') %>
<%- include('partials/footer') %>
