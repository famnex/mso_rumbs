<%- include('../partials/header') %>

<div class="calendar-header-bar card" style="margin-bottom: 24px;">
    <div class="calendar-info">
        <div class="calendar-breadcrumb">
            <a href="/">Dashboard</a> &raquo; <a href="/admin">Systemsteuerung</a> &raquo; <strong>Stunden verwalten</strong>
        </div>
        <h2>⏰ Unterrichtsstunden verwalten</h2>
    </div>
    <div class="calendar-controls">
        <a href="/admin" class="btn-nav-week" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
            <span>🛠️ Systemsteuerung</span>
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header-with-action">
        <div>
            <h3>⏰ Vorhandene Unterrichtsstunden</h3>
            <p class="card-desc">Übersicht aller für Belegungen definierten Stunden.</p>
        </div>
        <button class="btn-action-trigger" onclick="openModal('add-period-modal')">
            <span>➕ Neue Stunde anlegen</span>
        </button>
    </div>

    <div class="table-responsive">
        <table class="zebra-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Beginn</th>
                    <th>Ende</th>
                    <th>Buchbar</th>
                    <th>Sonderfarbe</th>
                    <th style="text-align: right;">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                <% if (periods && periods.length) { %>
                    <% periods.forEach(period => { %>
                        <tr>
                            <td><%= period.period_id %></td>
                            <td>
                                <% if (period.color) { %>
                                    <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: <%= period.color %>; margin-right: 6px;"></span>
                                <% } %>
                                <strong><%= period.name %></strong>
                            </td>
                            <td><%= period.time_start.slice(0, 5) %> Uhr</td>
                            <td><%= period.time_end.slice(0, 5) %> Uhr</td>
                            <td>
                                <span class="status-badge <%= period.bookable ? 'status-open' : 'status-closed' %>">
                                    <%= period.bookable ? 'Ja' : 'Nein' %>
                                </span>
                            </td>
                            <td>
                                <% if (period.color) { %>
                                    <span class="status-badge" style="background: <%= period.color %>1f; color: <%= period.color %>; border: 1px solid <%= period.color %>40; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                                        <span style="width: 8px; height: 8px; border-radius: 50%; background: <%= period.color %>;"></span>
                                        <%= period.color %>
                                    </span>
                                <% } else { %>
                                    <span style="color: var(--text-muted); font-style: italic; font-size: 13px;">Standard</span>
                                <% } %>
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <button class="btn-edit-sm" onclick="openEditPeriodModal('<%= period.period_id %>', '<%= (period.name || '').replace(/'/g, "\\'") %>', '<%= period.time_start.slice(0, 5) %>', '<%= period.time_end.slice(0, 5) %>', '<%= period.bookable %>', '<%= period.color || '' %>')">
                                    ✏️ Bearbeiten
                                </button>
                                <form action="/admin/periods/delete" method="POST" onsubmit="return confirm('Möchten Sie diese Stunde wirklich löschen? Alle zugehörigen Buchungen werden storniert!');" style="display:inline;">
                                    <input type="hidden" name="period_id" value="<%= period.period_id %>">
                                    <button type="submit" class="btn-danger-sm">🗑️ Löschen</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center">Keine Unterrichtsstunden vorhanden.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Add Period Modal -->
<div id="add-period-modal" class="modal-overlay hidden" onclick="closeModal('add-period-modal')">
    <div class="modal-card card" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h3>🆕 Stunde hinzufügen</h3>
            <button class="btn-close-modal" onclick="closeModal('add-period-modal')">&times;</button>
        </div>
        <p class="modal-desc">Definieren Sie eine neue Stunde für den Zeitplan.</p>
        
        <form action="/admin/periods/add" method="POST" class="modern-form compact">
            <div class="form-group">
                <label for="period-name">Stunden-Bezeichnung</label>
                <input type="text" name="name" id="period-name" placeholder="z. B. 7. Stunde, Mittagsband" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="time-start">Beginn (HH:MM)</label>
                    <input type="time" name="time_start" id="time-start" required>
                </div>

                <div class="form-group">
                    <label for="time-end">Ende (HH:MM)</label>
                    <input type="time" name="time_end" id="time-end" required>
                </div>
            </div>

            <div class="form-group">
                <label for="add-period-color">Sonderfarbe (Hervorhebung im Belegungsplan)</label>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <input type="color" id="add-period-color-picker" value="#3b82f6" oninput="document.getElementById('add-period-color').value = this.value" style="width: 44px; height: 38px; padding: 2px; border-radius: 8px; border: 1px solid var(--border-color); cursor: pointer; background: var(--input-bg);">
                    <input type="text" name="color" id="add-period-color" placeholder="z. B. #ef4444 (optional)" oninput="if(this.value.length===7 && this.value.startsWith('#')) document.getElementById('add-period-color-picker').value = this.value" style="flex: 1; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600;">
                    <button type="button" class="btn-secondary" style="padding: 8px 12px; font-size: 12px; border-radius: 8px; font-weight: 600;" onclick="document.getElementById('add-period-color').value=''; document.getElementById('add-period-color-picker').value='#3b82f6';">Leeren</button>
                </div>
                <small style="color: var(--text-muted); display: block; margin-top: 4px;">Wählen Sie eine Farbe zur farblichen Hervorhebung dieser Stunde im Kalender (z. B. für Pausen, Mittagsband, Sonderzeiten).</small>
            </div>

            <div class="form-group inline-checkbox">
                <input type="checkbox" name="bookable" id="period-bookable" value="1" checked>
                <label for="period-bookable">Für Lehrer zur Buchung freigeben</label>
            </div>

            <button type="submit" class="btn-primary-block">
                <span>➕ Stunde erstellen</span>
            </button>
        </form>
    </div>
</div>

<!-- Edit Period Modal -->
<div id="edit-period-modal" class="modal-overlay hidden" onclick="closeModal('edit-period-modal')">
    <div class="modal-card card" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h3>✏️ Stunde bearbeiten</h3>
            <button class="btn-close-modal" onclick="closeModal('edit-period-modal')">&times;</button>
        </div>
        <p class="modal-desc">Ändern Sie die Bezeichnung oder Zeitgrenzen der Stunde.</p>
        
        <form action="/admin/periods/edit" method="POST" class="modern-form compact">
            <input type="hidden" name="period_id" id="edit-period-id">
            
            <div class="form-group">
                <label for="edit-period-name">Stunden-Bezeichnung</label>
                <input type="text" name="name" id="edit-period-name" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="edit-period-start">Beginn (HH:MM)</label>
                    <input type="time" name="time_start" id="edit-period-start" required>
                </div>

                <div class="form-group">
                    <label for="edit-period-end">Ende (HH:MM)</label>
                    <input type="time" name="time_end" id="edit-period-end" required>
                </div>
            </div>

            <div class="form-group">
                <label for="edit-period-color">Sonderfarbe (Hervorhebung im Belegungsplan)</label>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <input type="color" id="edit-period-color-picker" value="#3b82f6" oninput="document.getElementById('edit-period-color').value = this.value" style="width: 44px; height: 38px; padding: 2px; border-radius: 8px; border: 1px solid var(--border-color); cursor: pointer; background: var(--input-bg);">
                    <input type="text" name="color" id="edit-period-color" placeholder="z. B. #ef4444 (optional)" oninput="if(this.value.length===7 && this.value.startsWith('#')) document.getElementById('edit-period-color-picker').value = this.value" style="flex: 1; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600;">
                    <button type="button" class="btn-secondary" style="padding: 8px 12px; font-size: 12px; border-radius: 8px; font-weight: 600;" onclick="document.getElementById('edit-period-color').value=''; document.getElementById('edit-period-color-picker').value='#3b82f6';">Leeren</button>
                </div>
                <small style="color: var(--text-muted); display: block; margin-top: 4px;">Wählen Sie eine Farbe zur farblichen Hervorhebung dieser Stunde im Kalender (z. B. für Pausen, Mittagsband, Sonderzeiten).</small>
            </div>

            <div class="form-group inline-checkbox">
                <input type="checkbox" name="bookable" id="edit-period-bookable" value="1">
                <label for="edit-period-bookable">Für Lehrer zur Buchung freigeben</label>
            </div>

            <button type="submit" class="btn-primary-block">
                <span>💾 Änderungen speichern</span>
            </button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
