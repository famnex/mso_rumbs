<!DOCTYPE html>
<html lang="de" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= schoolName %></title>
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Inline CSS to support immediate theme rendering (prevents flash of light theme in dark mode) -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <div class="outer">
        <header class="main-header">
            <div class="brand">
                <a href="/" class="brand-link">
                    <span class="brand-icon">🏫</span>
                    <span class="brand-text">Raum- und Medienbuchungssystem</span>
                </a>
            </div>
            
            <% if (typeof displayName !== 'undefined' && displayName) { %>
                <nav class="main-nav">
                    <!-- Home-Button -->
                    <a href="/dashboard" class="nav-item-iconic" title="Dashboard">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                    </a>
                    
                    <!-- User Menu Trigger & Dropdown -->
                    <div class="user-dropdown-container">
                        <button class="user-control-iconic" id="user-menu-trigger" aria-label="Benutzermenü öffnen">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                            <span class="user-greeting-compact"><%= displayName %></span>
                        </button>
                        
                        <div class="user-dropdown hidden" id="user-dropdown">
                            <a href="/bookings/my-bookings" class="dropdown-item">
                                <span class="dropdown-icon">📅</span>
                                <span>Meine Buchungen</span>
                            </a>
                            
                            <% if (typeof authlevel !== 'undefined' && authlevel === 1) { %>
                                <a href="/admin" class="dropdown-item admin-item">
                                    <span class="dropdown-icon">⚙️</span>
                                    <span>Systemsteuerung</span>
                                </a>
                            <% } %>
                            
                            <!-- Theme Toggle inside Dropdown -->
                            <button id="theme-toggle-dropdown" class="dropdown-item theme-toggle-btn" type="button">
                                <span class="theme-icon-sun">☀️</span>
                                <span class="theme-icon-moon">🌙</span>
                                <span class="theme-text">Farbschema umschalten</span>
                            </button>
                            
                            <div class="dropdown-divider"></div>
                            
                            <a href="/logout" class="dropdown-item logout-item">
                                <span class="dropdown-icon">🚪</span>
                                <span><%= typeof logoutButtonText !== 'undefined' && logoutButtonText ? logoutButtonText : 'Abmelden' %></span>
                            </a>
                        </div>
                    </div>
                </nav>
            <% } else { %>
                <!-- Hardware-accelerated Theme Toggler (Logged Out) -->
                <button id="theme-toggle" class="theme-btn" aria-label="Farbschema umschalten" style="margin-left: auto;">
                    <span class="sun-icon">☀️</span>
                    <span class="moon-icon">🌙</span>
                </button>
            <% } %>
        </header>
        
        <main class="content-area">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error">
                    <span class="alert-icon">⚠️</span>
                    <span class="alert-message"><%= error %></span>
                </div>
            <% } %>
            
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success">
                    <span class="alert-icon">✅</span>
                    <span class="alert-message"><%= success %></span>
                </div>
            <% } %>
