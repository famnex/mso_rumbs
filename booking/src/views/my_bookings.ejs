<%- include('partials/header') %>

<div class="my-bookings-container">
    <!-- Header Hero Card -->
    <div class="dashboard-hero card" style="margin-bottom: 24px;">
        <div class="hero-overlay">
            <span class="hero-tag">📋 Buchungsübersicht</span>
            <h2>Willkommen in Ihrer persönlichen Belegungsverwaltung</h2>
            <p>Sehen Sie all Ihre aktiven Reservierungen ein oder stöbern Sie in Ihrem vergangenen Buchungsarchiv. Sie können anstehende Buchungen hier auch direkt stornieren.</p>
        </div>
    </div>

    <!-- Tab Navigation & Action Controls -->
    <div class="bookings-tab-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 15px; flex-wrap: wrap;">
        <div class="tab-buttons" style="display: flex; gap: 8px; background: rgba(255, 255, 255, 0.05); padding: 5px; border-radius: 14px; border: 1px solid var(--border-color); backdrop-filter: blur(8px);">
            <a href="/bookings/my-bookings" class="tab-btn <%= !showArchive ? 'active-tab' : '' %>" style="padding: 10px 20px; border-radius: 10px; font-weight: 700; font-size: 13.5px; text-decoration: none; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
                📅 Aktive Buchungen
            </a>
            <a href="/bookings/my-bookings?archive=true" class="tab-btn <%= showArchive ? 'active-tab' : '' %>" style="padding: 10px 20px; border-radius: 10px; font-weight: 700; font-size: 13.5px; text-decoration: none; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
                🗄️ Buchungsarchiv
            </a>
        </div>
        
        <a href="/bookings" class="btn-sso-login" style="margin: 0; padding: 12px 20px; border-radius: 14px; display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13.5px; text-decoration: none;">
            <span>➕ Neue Reservierung vornehmen</span>
        </a>
    </div>

    <!-- Bookings Table / List Card -->
    <div class="card" style="padding: 24px; overflow-x: auto;">
        <% if (bookings && bookings.length) { %>
            <table class="zebra-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr>
                        <th style="padding: 16px; border-bottom: 2px solid var(--border-color); font-weight: 700; color: var(--text-muted);">🚪 Medium / Raum</th>
                        <th style="padding: 16px; border-bottom: 2px solid var(--border-color); font-weight: 700; color: var(--text-muted);">📅 Datum / Typ</th>
                        <th style="padding: 16px; border-bottom: 2px solid var(--border-color); font-weight: 700; color: var(--text-muted);">⏰ Stunde</th>
                        <th style="padding: 16px; border-bottom: 2px solid var(--border-color); font-weight: 700; color: var(--text-muted);">📝 Zweck / Klasse</th>
                        <th style="padding: 16px; border-bottom: 2px solid var(--border-color); font-weight: 700; color: var(--text-muted); text-align: right;">Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    <% bookings.forEach(booking => { %>
                        <tr style="transition: background-color 0.2s; border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                            <!-- Room info -->
                            <td style="padding: 16px; font-weight: 700; color: var(--text-main);">
                                <span style="display: inline-flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 18px;">🚪</span>
                                    <%= booking.room_name %>
                                </span>
                            </td>
                            
                            <!-- Date info -->
                            <td style="padding: 16px;">
                                <% if (booking.date) { %>
                                    <% 
                                        const dateObj = new Date(booking.date);
                                        const formattedDate = dateObj.toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
                                    %>
                                    <span class="status-badge" style="background: rgba(59, 130, 246, 0.1); color: var(--primary); border: 1px solid rgba(59, 130, 246, 0.2); font-weight: 600;">
                                        <%= formattedDate %>
                                    </span>
                                <% } else { %>
                                    <!-- Recurring Timetabled entry -->
                                    <% 
                                        const weekDays = ['', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag'];
                                        const dayName = weekDays[booking.day_num] || `Tag ${booking.day_num}`;
                                    %>
                                    <span class="status-badge" style="background: rgba(245, 158, 11, 0.1); color: var(--warning); border: 1px solid rgba(245, 158, 11, 0.2); font-weight: 600;" title="Regulärer Stundenplaneintrag">
                                        🔁 <%= dayName %> <%= booking.week_name ? `(${booking.week_name})` : '(Jede Woche)' %>
                                    </span>
                                <% } %>
                            </td>
                            
                            <!-- Period / Time info -->
                            <td style="padding: 16px;">
                                <div style="font-weight: 600; color: var(--text-main);"><%= booking.period_name %></div>
                                <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 2px;">
                                    <%= booking.time_start.slice(0, 5) %> - <%= booking.time_end.slice(0, 5) %> Uhr
                                </div>
                            </td>
                            
                            <!-- Purpose / Notes -->
                            <td style="padding: 16px;">
                                <% if (booking.notes) { %>
                                    <span style="font-style: italic; color: var(--text-main);">"<%= booking.notes %>"</span>
                                <% } else { %>
                                    <span style="color: var(--text-muted); font-size: 13px;">Keine Angabe</span>
                                <% } %>
                            </td>
                            
                            <!-- Actions -->
                            <td style="padding: 16px; text-align: right;">
                                <% if (!showArchive) { %>
                                    <div style="display: inline-flex; gap: 6px; align-items: center;">
                                        <button type="button" class="btn-secondary" style="padding: 8px 12px; font-size: 12.5px; font-weight: 700; border-radius: 10px; cursor: pointer;"
                                            data-booking-id="<%= booking.booking_id %>"
                                            data-notes="<%= booking.notes || '' %>"
                                            data-room-name="<%= booking.room_name || 'Raum' %>"
                                            data-period-name="<%= booking.period_name || 'Stunde' %>"
                                            data-date="<%= booking.date || '' %>"
                                            data-is-timetable="<%= booking.date ? 'false' : 'true' %>"
                                            data-week-id="<%= booking.week_id || '' %>"
                                            data-date-start="<%= booking.date_start || '' %>"
                                            data-date-end="<%= booking.date_end || '' %>"
                                            data-user-name="<%= booking.displayname || booking.username || 'Sie selbst' %>"
                                            data-redirect-to="/bookings/my-bookings"
                                            onclick="handleEditBtnClick(event, this)">
                                            ✏️ Bearbeiten
                                        </button>
                                        <form action="/bookings/cancel" method="POST" onsubmit="return confirm('Möchten Sie diese Reservierung wirklich stornieren?');" style="margin: 0; display: inline-block;">
                                            <input type="hidden" name="booking_id" value="<%= booking.booking_id %>">
                                            <input type="hidden" name="redirect_to" value="/bookings/my-bookings">
                                            <button type="submit" class="btn-danger-sm" style="padding: 8px 14px; font-size: 12.5px; font-weight: 700; border-radius: 10px; display: inline-flex; align-items: center; gap: 4px;">
                                                🗑️ Stornieren
                                            </button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <span class="status-badge" style="background: rgba(16, 185, 129, 0.1); color: var(--success); border: 1px solid rgba(16, 185, 129, 0.2); font-weight: 700; font-size: 12px; display: inline-block; padding: 4px 8px;">
                                        ✓ Archiviert
                                    </span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <!-- Pagination UI -->
            <% if (totalPages > 1) { %>
                <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
                    <% if (currentPage > 1) { %>
                        <a href="/bookings/my-bookings?archive=<%= showArchive %>&page=<%= currentPage - 1 %>" class="btn-nav-week" style="padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; font-size: 13px;">&larr; Zurück</a>
                    <% } %>
                    
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === currentPage) { %>
                            <span class="tab-btn active-tab" style="padding: 8px 14px; border-radius: 8px; font-weight: 700; font-size: 13px;"><%= i %></span>
                        <% } else { %>
                            <a href="/bookings/my-bookings?archive=<%= showArchive %>&page=<%= i %>" class="tab-btn" style="padding: 8px 14px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px;"><%= i %></a>
                        <% } %>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/bookings/my-bookings?archive=<%= showArchive %>&page=<%= currentPage + 1 %>" class="btn-nav-week" style="padding: 8px 14px; text-decoration: none; display: inline-flex; align-items: center; font-size: 13px;">Weiter &rarr;</a>
                    <% } %>
                </div>
            <% } %>

        <% } else { %>
            <div style="text-align: center; padding: 60px 20px;">
                <div style="font-size: 52px; margin-bottom: 20px;">📅</div>
                <h3 style="font-size: 20px; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">
                    <%= showArchive ? 'Ihr Archiv ist leer' : 'Keine anstehenden Buchungen' %>
                </h3>
                <p style="color: var(--text-muted); max-width: 400px; margin: 0 auto 24px auto; font-size: 14px; line-height: 1.5;">
                    <%= showArchive ? 'Es wurden noch keine Belegungen in der Vergangenheit abgeschlossen oder archiviert.' : 'Sie haben aktuell keine anstehenden Unterrichtsräume oder Medienslots reserviert.' %>
                </p>
                <% if (!showArchive) { %>
                    <a href="/bookings" class="btn-sso-login" style="margin: 0; padding: 12px 24px; border-radius: 14px; display: inline-flex; align-items: center; gap: 8px; font-weight: 700; text-decoration: none;">
                        <span>🚪 Belegungsplan öffnen</span>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<!-- Inline CSS to support tabs and aesthetic states -->
<style>
    .tab-btn {
        color: var(--text-muted);
        background: transparent;
    }
    
    .tab-btn:hover {
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.03);
    }
    
    .active-tab {
        background: var(--card-bg) !important;
        color: var(--primary) !important;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 12px var(--primary-glow);
    }
    
    .zebra-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.02) !important;
    }
<!-- Universal Edit Booking Modal -->
<div id="edit-booking-modal" class="modal-overlay hidden" onclick="closeModal('edit-booking-modal')">
    <div class="modal-card card" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h3 id="edit-booking-modal-title">✏️ Buchung bearbeiten</h3>
            <button class="btn-close-modal" onclick="closeModal('edit-booking-modal')">&times;</button>
        </div>
        <p class="modal-desc">Passen Sie die Details dieser Buchung an.</p>
        
        <form action="/bookings/edit" method="POST" class="modern-form compact">
            <input type="hidden" name="booking_id" id="edit-booking-id">
            <input type="hidden" name="redirect_to" id="edit-booking-redirect-to" value="/bookings/my-bookings">

            <div class="form-row" style="margin-bottom: 12px;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Medium / Raum</label>
                    <input type="text" id="edit-booking-room-name" readonly class="input-readonly" style="padding: 10px;">
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Datum / Wochentag</label>
                    <input type="text" id="edit-booking-date-formatted" readonly class="input-readonly" style="padding: 10px;">
                </div>
            </div>

            <div class="form-row" style="margin-bottom: 12px;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Unterrichtsstunde</label>
                    <input type="text" id="edit-booking-period-name" readonly class="input-readonly" style="padding: 10px;">
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Gebucht von</label>
                    <input type="text" id="edit-booking-user" readonly class="input-readonly" style="padding: 10px;">
                </div>
            </div>

            <% if (authlevel === 1) { %>
                <!-- Timetable specific fields (Turnus, Von, Bis) for Admins -->
                <div id="edit-timetable-fields-group" class="hidden">
                    <div class="form-group" style="margin-bottom: 12px;">
                        <label for="edit-booking-week-id">Wiederholung (Turnus)</label>
                        <select name="week_id" id="edit-booking-week-id" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600;">
                            <option value="">Wöchentlich (Jede Woche)</option>
                            <% if (typeof weeks !== 'undefined' && weeks && weeks.length) { %>
                                <% weeks.forEach(wk => { %>
                                    <option value="<%= wk.week_id %>"><%= wk.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-row" style="margin-bottom: 12px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="edit-booking-date-start">Gültig von (Startdatum)</label>
                            <input type="date" name="date_start" id="edit-booking-date-start" style="padding: 10px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600; width: 100%;">
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="edit-booking-date-end">Gültig bis (Enddatum)</label>
                            <input type="date" name="date_end" id="edit-booking-date-end" style="padding: 10px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-weight: 600; width: 100%;">
                        </div>
                    </div>
                </div>
            <% } %>

            <div class="form-group" style="margin-bottom: 20px;">
                <label for="edit-booking-notes">Verwendungszweck / Klasse</label>
                <input type="text" name="notes" id="edit-booking-notes" placeholder="z. B. 10b Informatik" required style="padding: 12px;">
            </div>

            <button type="submit" class="btn-primary-block" style="width: 100%;">
                <span>💾 Änderungen speichern</span>
            </button>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
